// Vercel本番デプロイ用スキーマ
// デプロイ前に schema.prisma の内容をこれに置き換えること

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Profile {
  id               String         @id @default(cuid())
  lineUserId       String         @unique
  displayName      String?
  pictureUrl       String?
  isAdmin          Boolean        @default(false)
  isStudent        Boolean        @default(false)
  stripeCustomerId String?
  realName         String?
  playerName       String?
  gender           String?
  ageGroup         String?
  region           String?
  surveyCompleted  Boolean        @default(false)
  createdAt        DateTime       @default(now())
  visitSessions    VisitSession[]
  payments         Payment[]
  subscription     Subscription?
}

model VisitSession {
  id              String      @id @default(cuid())
  profileId       String
  profile         Profile     @relation(fields: [profileId], references: [id])
  checkedInAt     DateTime    @default(now())
  checkedOutAt    DateTime?
  durationMinutes Int?
  amountYen       Int?
  billingType     String      @default("pay_per_use")
  payment         Payment?
  orderItems      OrderItem[]
  createdAt       DateTime    @default(now())
}

model Payment {
  id                    String        @id @default(cuid())
  profileId             String
  profile               Profile       @relation(fields: [profileId], references: [id])
  visitSessionId        String?       @unique
  visitSession          VisitSession? @relation(fields: [visitSessionId], references: [id])
  stripePaymentIntentId String?
  stripeInvoiceId       String?
  amountYen             Int
  status                String        @default("pending")
  paymentType           String
  createdAt             DateTime      @default(now())
}

model Subscription {
  id                   String    @id @default(cuid())
  profileId            String    @unique
  profile              Profile   @relation(fields: [profileId], references: [id])
  stripeSubscriptionId String    @unique
  stripePriceId        String
  planName             String
  status               String
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// ⚠️ 旧・従量課金(30分ごと)の設定。2026-07-28にプラン制(PricePlan)へ移行したため未使用。
model PricingConfig {
  id              String   @id @default(cuid())
  label           String
  intervalMinutes Int
  amountYen       Int
  appliesTo       String   @default("pay_per_use")
  isActive        Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

// 料金プラン（滞在時間で自動判定する段階制）
model PricePlan {
  id         String   @id @default(cuid())
  label      String
  maxMinutes Int?     // null = フリー（上限なし）
  amountYen  Int
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

// 追加メニュー（フード・ドリンク）。kind = "count" / "toggle"
model MenuItem {
  id         String      @id @default(cuid())
  label      String
  priceYen   Int
  kind       String      @default("count")
  sortOrder  Int         @default(0)
  isActive   Boolean     @default(true)
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]
}

// 来店セッションごとの注文。1セッション×1メニュー=1行。
model OrderItem {
  id             String       @id @default(cuid())
  visitSessionId String
  visitSession   VisitSession @relation(fields: [visitSessionId], references: [id])
  menuItemId     String
  menuItem       MenuItem     @relation(fields: [menuItemId], references: [id])
  quantity       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([visitSessionId, menuItemId])
}
